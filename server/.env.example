# Server Configuration
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Database Engine Configuration
# Supported engines: mysql (default), postgresql, postgres, memory
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prettier_mails
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# PostgreSQL Alternative:
# DB_ENGINE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=prettier_mails
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=false

# AI API Keys (Optional - Can also be configured directly in client UI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Security & Encryption Key (for SMTP credentials encryption)
APP_ENCRYPTION_KEY=prettiermils-default-secret-encryption-key-32-chars!
